# Flutter et Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
*.iml
.idea/
.vscode/

# Textes générés par flutter gen-l10n
lib/l10n/gen/

# Android : build.gradle.kts, le manifeste et le widget d'écran d'accueil sont versionnés,
# le reste est recréé par « flutter create --platforms=android . »
/android/*
!/android/app/
/android/app/*
!/android/app/build.gradle.kts
!/android/app/src/
/android/app/src/*
!/android/app/src/main/
/android/app/src/main/*
!/android/app/src/main/AndroidManifest.xml
!/android/app/src/main/kotlin/
/android/app/src/main/kotlin/**/MainActivity.kt
!/android/app/src/main/res/
/android/app/src/main/res/*
!/android/app/src/main/res/layout/
/android/app/src/main/res/layout/*
!/android/app/src/main/res/layout/objectif_widget.xml
!/android/app/src/main/res/xml/
/android/app/src/main/res/xml/*
!/android/app/src/main/res/xml/objectif_widget_info.xml

# Clé de signature, jamais dans le dépôt
*.jks
*.keystore
key.properties

# iOS, Web et bureau non utilisés
/ios/
/web/
/linux/
/macos/
/windows/

# Captures générées par le workflow Captures
test/captures/png/
